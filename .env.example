# This root file is a pointer, not the real config — DecisionIQ's actual
# environment files live per-app so frontend and backend secrets never mix:
#
#   backend/.env.example   -> copy to backend/.env
#   frontend/.env.example  -> copy to frontend/.env.local
#
# See docs/ENVIRONMENT.md for the full variable reference.
#
# If you're using docker-compose.yml directly, it also reads these from
# the shell environment (or a root .env Docker Compose auto-loads):
POSTGRES_DB=decisioniq
POSTGRES_USER=decisioniq
POSTGRES_PASSWORD=decisioniq
